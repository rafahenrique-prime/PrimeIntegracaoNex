*.xls
*.xlsx
EXPORTADOS/
LOGS/
OUTPUT/
PROCESSADOS/

# Logs do npm/yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# Variaveis de ambiente e segredos
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.cer
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
