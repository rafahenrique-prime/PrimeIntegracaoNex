*.credentials

# Temporarios comuns do Windows
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Temporarios comuns de editores
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
.idea/
*.bak
*.tmp
*.temp

# PRIME NEX EXPORT AGENT (WINDOWS/) - build .NET nao versionado
# (F6.11 secao 15: codigo-fonte versionado, binario nao necessariamente
# commitado - build reproduzivel via dotnet build/publish).
WINDOWS/**/bin/
WINDOWS/**/obj/
