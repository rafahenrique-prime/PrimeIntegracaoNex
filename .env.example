# Configuracao do Repository HTTP (Fase F1A.2) - PrimeIntegracaoNex -> PRIME COBRANCAS.
# Copie este arquivo para .env (ja ignorado pelo Git) e preencha com valores reais.
# NUNCA coloque o secret real neste arquivo (.env.example) nem em qualquer arquivo versionado.

# Endpoint do backend function webhookNex no PRIME COBRANCAS.
NEX_PRIME_ENDPOINT=https://primecobrancas.base44.app/functions/webhookNex

# Identificador estavel desta instalacao/loja do NEX.
NEX_PRIME_ORIGIN=prime-store-udi-nex-01

# Secret compartilhado para assinatura HMAC-SHA256 (X-Nex-Signature).
# Obtenha o valor real com quem administra o PRIME COBRANCAS - nunca invente,
# nunca hardcode, nunca commite o valor real.
NEX_PRIME_INTEGRATION_SECRET=coloque_o_secret_real_aqui_fora_do_git
